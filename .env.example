# ============================================
# NetWatch - Configuration de deployment
# Copiez ce fichier en .env et remplissez les valeurs
# NE PAS COMMITTER .env dans git !
# ============================================

# ===== BASE DE DONNÉES =====
DB_NAME=netwatch
DB_USER=netwatch
DB_PASSWORD=ChangeMe_DbPass2024!
MYSQL_ROOT_PASSWORD=ChangeMe_RootPass2024!
DB_PORT_EXPOSED=3306

# ===== APPLICATION =====
SERVER_PORT=8080

# ===== SÉCURITÉ JWT =====
# Clé de 256+ bits, changez obligatoirement !
JWT_SECRET=NetWatch_ChangeThis_SecretKey_2024_Icone_Communication_Abidjan_CI!

# ===== EMAIL (Gmail) =====
# Pour Gmail: activez "Mots de passe d'application" dans les paramètres Google
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votremail@gmail.com
MAIL_PASSWORD=votre_app_password_gmail

# ===== WHATSAPP (optionnel) =====
# Mettre à true pour activer les notifications WhatsApp via CallMeBot
WHATSAPP_ENABLED=false

# ===== MONITORING =====
# Intervalle entre les pings (secondes)
PING_INTERVAL=60
# Timeout des pings (millisecondes)
PING_TIMEOUT=5000
# Nombre d'échecs consécutifs avant alerte
ALERT_THRESHOLD=3
# Nombre de succès consécutifs pour marques "rétabli"
RECOVERY_CHECK=2
